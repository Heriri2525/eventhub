# Session secret for JWT signing (generate a random 32+ character string)
SESSION_SECRET=your-super-secret-key-change-this-in-production

# Ticketmaster API key (get from https://developer.ticketmaster.com/)
TICKETMASTER_API_KEY=your-ticketmaster-api-key

# Chapa payment gateway secret key (get from https://dashboard.chapa.co/)
CHAPA_SECRET_KEY=your-chapa-secret-key

# Site URL for metadata and redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
